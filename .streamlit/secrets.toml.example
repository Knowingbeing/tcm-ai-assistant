# Streamlit secrets 模板
# 复制为 .streamlit/secrets.toml 后填写真实值。
# 不要提交 .streamlit/secrets.toml。

# OpenAI 兼容模型服务，按实际厂商填写其中一个或多个。
OPENAI_API_KEY = ""
DEEPSEEK_API_KEY = ""
DASHSCOPE_API_KEY = ""
MOONSHOT_API_KEY = ""
ZHIPU_API_KEY = ""
SILICONFLOW_API_KEY = ""

# Supabase 可选；未配置时自动使用 data/tcm_records.json 本地兜底。
SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_KEY = "your-anon-key"
